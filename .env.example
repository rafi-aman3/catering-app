# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; do not commit secrets.
# When you add a new variable, update this file in the same PR.

# --- Supabase (required) ---
# Project URL — Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — Project Settings → API. Safe to expose to the browser.
# (Replaces the older "anon" key; the legacy anon JWT is also accepted.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — Project Settings → API. Server-only. Never prefix with NEXT_PUBLIC_.
# (Replaces the older "service_role" key; legacy service_role JWT is also accepted.)
# Used by /system routes and server-side admin operations.
SUPABASE_SECRET_KEY=

# --- App URL (required) ---
# Public origin of the running app. Used for OAuth redirects and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional in dev; required to actually send mail) ---
RESEND_API_KEY=
# Verified sender. Resend requires a verified domain in production.
EMAIL_FROM=Catering App <noreply@example.com>

# --- Observability (optional in dev) ---
# Sentry — leave blank to disable
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — leave blank to disable
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
